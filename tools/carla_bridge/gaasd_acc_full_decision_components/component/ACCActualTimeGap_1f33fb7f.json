            "key": "other_config",
            "value": [
                {
                    "standard_library_function": false,
                    "function_body": "double ACCActualTimeGap(double egoV, double distance)\n{\n    double actualTimeGap = 9999.0;\n    double distanceSafe = distance;\n\n    if (distanceSafe < 0.0) {\n        distanceSafe = 0.0;\n    }\n\n    if (egoV > 0.1) {\n        actualTimeGap = distanceSafe / egoV;\n    }\n\n    return actualTimeGap;\n}",
