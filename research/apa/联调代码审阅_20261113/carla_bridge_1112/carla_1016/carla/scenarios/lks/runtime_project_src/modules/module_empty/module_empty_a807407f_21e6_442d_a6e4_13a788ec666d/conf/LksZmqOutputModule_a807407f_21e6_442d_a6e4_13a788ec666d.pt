
basic {
  path: "lib/libLksZmqOutputModule_a807407f_21e6_442d_a6e4_13a788ec666d.so"
  module_type: APP
  ioconfig {
    subscribers {
      name: "lks_output"
      channel: "lks_output"
      bindcode: ON
    }
    tasks {
      task_name: "lks_output"
      bindcode: ON
      task_option {
        task_type: POLICY_TYPE_MSG_NEWEST
        message_num: 1
        timer_trigger_interval: 20
        input_trigger: "lks_output"
      }
      input: "lks_output"
    }
  }
}

params {
  target_speed_mps: 3.0
  driver_steer_max_rad: 0.6
}
