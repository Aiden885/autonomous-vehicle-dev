#!/usr/bin/env bash
set -euo pipefail

SCENARIO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCENARIO_DIR}/../.." && pwd)"

export CARLA_ROOT="${CARLA_ROOT:-/opt/carla}"
export CARLA_HOST="${CARLA_HOST:-127.0.0.1}"
export CARLA_PORT="${CARLA_PORT:-2000}"
export PYTHON_BIN="${PYTHON_BIN:-python3.8}"
BASE_CONFIG_PATH="${CONFIG_PATH:-${SCENARIO_DIR}/bridge_config.json}"
export GAASD_CARLA_LOG_DIR="${GAASD_CARLA_LOG_DIR:-/tmp/newaccpro4-accel-codegen-carla/carla}"
export GAASD_PANEL_PORT="${GAASD_PANEL_PORT:-8088}"

ACC_LEAD_SPEED_MPS="${ACC_LEAD_SPEED_MPS:-2.0}"
ACC_LEAD_DISTANCE_M="${ACC_LEAD_DISTANCE_M:-30.0}"
ACC_LEAD_STEP_SPEED_MPS="${ACC_LEAD_STEP_SPEED_MPS:-$ACC_LEAD_SPEED_MPS}"
ACC_LEAD_STEP_TIME_SEC="${ACC_LEAD_STEP_TIME_SEC:-0.0}"
ACC_LEAD_MAX_THROTTLE="${ACC_LEAD_MAX_THROTTLE:-0.8}"
ACC_MAX_ACCEL_MPS2="${ACC_MAX_ACCEL_MPS2:-1.5}"
ACC_MAX_BRAKE_MPS2="${ACC_MAX_BRAKE_MPS2:-6.0}"
ACC_MAX_THROTTLE="${ACC_MAX_THROTTLE:-0.35}"
ACC_MAX_BRAKE="${ACC_MAX_BRAKE:-0.7}"

EGO_SPAWN_INDEX="${EGO_SPAWN_INDEX:-198}"
LEAD_PLACEMENT="${LEAD_PLACEMENT:-lane_waypoint}"
LEAD_BEHAVIOR="${LEAD_BEHAVIOR:-waypoint_pid}"
SPECTATOR_BACK="${SPECTATOR_BACK:-8}"
SPECTATOR_UP="${SPECTATOR_UP:-6}"
SPECTATOR_PITCH="${SPECTATOR_PITCH:--25}"
WATCH_CAMERA="${WATCH_CAMERA:-0}"
PROBE_BRIDGE="${PROBE_BRIDGE:-0}"
START_PANEL="${START_PANEL:-1}"
RESTART_BRIDGE="${RESTART_BRIDGE:-1}"
export WAIT_EGO_SEC="${WAIT_EGO_SEC:-30}"
RUNTIME_CONFIG_PATH="${GAASD_CARLA_LOG_DIR}/bridge_runtime_config.json"

require_file() {
  if [[ ! -e "$1" ]]; then
    echo "[ACC bridge-only] missing: $1" >&2
    exit 1
  fi
}

check_carla_ready() {
  "${PYTHON_BIN}" - "${CARLA_ROOT}" "${CARLA_HOST}" "${CARLA_PORT}" <<'PY'
import glob
import os
import sys

root = sys.argv[1]
host = sys.argv[2]
port = int(sys.argv[3])
paths = [os.path.join(root, "PythonAPI", "carla")]
paths.extend(glob.glob(os.path.join(root, "PythonAPI", "carla", "dist", "carla-*-py3*.egg")))
for path in reversed(paths):
    if path and os.path.exists(path) and path not in sys.path:
        sys.path.insert(0, path)

import carla  # type: ignore

client = carla.Client(host, port)
client.set_timeout(10.0)
world = client.get_world()
_ = world.get_map().name
PY
}

stop_pid_file() {
  local label="$1"
  local pid_file="$2"
  local pid=""
  if [[ ! -f "${pid_file}" ]]; then
    return 0
  fi
  pid="$(cat "${pid_file}" 2>/dev/null || true)"
  if [[ -n "${pid}" ]] && kill -0 "${pid}" >/dev/null 2>&1; then
    kill "${pid}" >/dev/null 2>&1 || true
    echo "[ACC bridge-only] stopped stale ${label} pid=${pid}"
  fi
  rm -f "${pid_file}"
}

stop_by_pattern() {
  local label="$1"
  local pattern="$2"
  local pids
  pids="$(pgrep -f "${pattern}" || true)"
  for pid in ${pids}; do
    if [[ "${pid}" != "$$" ]]; then
      kill "${pid}" >/dev/null 2>&1 || true
      echo "[ACC bridge-only] stopped stale ${label} pid=${pid}"
    fi
  done
}

stop_bridge_stack_only() {
  stop_pid_file "lead waypoint PID" "${GAASD_CARLA_LOG_DIR}/lead-waypoint-pid.pid"
  stop_by_pattern "lead waypoint PID" "tools/carla_bridge/lead-waypoint-pid-controller.py"
  stop_pid_file "watch camera" "${GAASD_CARLA_LOG_DIR}/watch-camera.pid"
  stop_by_pattern "watch camera" "tools/carla_bridge/watch-carla.py"
  stop_pid_file "spectator follow" "${GAASD_CARLA_LOG_DIR}/spectator.pid"
  stop_by_pattern "spectator follow" "tools/carla_bridge/set-spectator-follow.py"
  stop_pid_file "bridge" "${GAASD_CARLA_LOG_DIR}/bridge.pid"
  stop_by_pattern "bridge" "tools/carla_bridge/carla_bridge.py"
}

prepare_runtime_bridge_config() {
  mkdir -p "${GAASD_CARLA_LOG_DIR}"
  "${PYTHON_BIN}" - \
    "${BASE_CONFIG_PATH}" \
    "${RUNTIME_CONFIG_PATH}" \
    "${ACC_MAX_ACCEL_MPS2}" \
    "${ACC_MAX_BRAKE_MPS2}" \
    "${ACC_MAX_THROTTLE}" \
    "${ACC_MAX_BRAKE}" \
    "${CARLA_ROOT}" <<'PY'
import json
import sys
from pathlib import Path

source_path = Path(sys.argv[1])
output_path = Path(sys.argv[2])
config = json.loads(source_path.read_text(encoding="utf-8"))
carla_root = str(Path(sys.argv[7]).expanduser())
carla = config.setdefault("carla", {})
carla["root"] = carla_root
carla["python_api_paths"] = [str(Path(carla_root) / "PythonAPI/carla")]
control = config.setdefault("control", {})
control["max_accel_mps2"] = float(sys.argv[3])
control["max_brake_mps2"] = float(sys.argv[4])
control["max_throttle"] = float(sys.argv[5])
control["max_brake"] = float(sys.argv[6])
control["override_command_accel_limits"] = True
output_path.write_text(
    json.dumps(config, ensure_ascii=False, indent=2) + "\n",
    encoding="utf-8",
)
PY
  export CONFIG_PATH="${RUNTIME_CONFIG_PATH}"
}

require_file "${BASE_CONFIG_PATH}"
require_file "${REPO_ROOT}/tools/carla_bridge/start-gaasd-carla-manual.sh"
require_file "${REPO_ROOT}/tools/gaasd_scenario_panel/start-panel.sh"
command -v "${PYTHON_BIN}" >/dev/null 2>&1 || {
  echo "[ACC bridge-only] python not found: ${PYTHON_BIN}" >&2
  exit 1
}
[[ -d "${CARLA_ROOT}" ]] || {
  echo "[ACC bridge-only] CARLA root not found: ${CARLA_ROOT}" >&2
  exit 1
}

if ! check_carla_ready; then
  echo "[ACC bridge-only] CARLA is not ready at ${CARLA_HOST}:${CARLA_PORT}; start CARLA first." >&2
  exit 1
fi

prepare_runtime_bridge_config

if [[ "${RESTART_BRIDGE}" == "1" ]]; then
  stop_bridge_stack_only
fi

args=(
  --config "${CONFIG_PATH}"
  --carla-root "${CARLA_ROOT}"
  --host "${CARLA_HOST}"
  --port "${CARLA_PORT}"
  --python "${PYTHON_BIN}"
  --ego-spawn-index "${EGO_SPAWN_INDEX}"
  --lead-distance "${ACC_LEAD_DISTANCE_M}"
  --lead-speed "${ACC_LEAD_SPEED_MPS}"
  --lead-placement "${LEAD_PLACEMENT}"
  --lead-behavior "${LEAD_BEHAVIOR}"
  --follow-spectator
  --spectator-back "${SPECTATOR_BACK}"
  --spectator-up "${SPECTATOR_UP}"
  --spectator-pitch "${SPECTATOR_PITCH}"
)

if [[ "${RESTART_BRIDGE}" != "1" ]]; then
  args+=(--reuse-bridge)
fi

if [[ "${WATCH_CAMERA}" == "1" ]]; then
  args+=(--watch-camera)
fi

if [[ "${PROBE_BRIDGE}" != "1" ]]; then
  args+=(--no-probe)
fi

cd "${REPO_ROOT}"
echo "[ACC bridge-only] CARLA_ROOT=${CARLA_ROOT}"
echo "[ACC bridge-only] CONFIG_PATH=${CONFIG_PATH}"
echo "[ACC bridge-only] logs=${GAASD_CARLA_LOG_DIR}"
LEAD_WAYPOINT_STEP_SPEED_MPS="${ACC_LEAD_STEP_SPEED_MPS}" \
LEAD_WAYPOINT_STEP_AT_SEC="${ACC_LEAD_STEP_TIME_SEC}" \
LEAD_WAYPOINT_MAX_THROTTLE="${ACC_LEAD_MAX_THROTTLE}" \
bash "${REPO_ROOT}/tools/carla_bridge/start-gaasd-carla-manual.sh" "${args[@]}"

if [[ "${START_PANEL}" == "1" ]]; then
  echo "[ACC bridge-only] starting scenario panel"
  bash "${REPO_ROOT}/tools/gaasd_scenario_panel/start-panel.sh"
  echo "[ACC bridge-only] panel: http://127.0.0.1:${GAASD_PANEL_PORT}"
fi

echo "[ACC bridge-only] ready"
