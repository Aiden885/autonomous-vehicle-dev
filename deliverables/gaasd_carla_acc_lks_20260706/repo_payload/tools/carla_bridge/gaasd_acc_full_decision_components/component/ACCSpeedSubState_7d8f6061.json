                {
                    "standard_library_function": false,
                    "function_body": "int ACCSpeedSubState(double egoV, double vMinKmh)\n{\n    double vMin = 0.0;\n    int speedSubState = 0;\n\n    vMin = vMinKmh / 3.6;\n    if (egoV < vMin) {\n        speedSubState = 1;\n    } else {\n        speedSubState = 0;\n    }\n\n    return speedSubState;\n}",
