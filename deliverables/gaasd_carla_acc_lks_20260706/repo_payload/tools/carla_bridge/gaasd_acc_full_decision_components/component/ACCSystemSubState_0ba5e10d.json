                {
                    "standard_library_function": false,
                    "function_body": "int ACCSystemSubState(int controlEnabled, int hasHistory)\n{\n    int systemSubState = 0;\n\n    if (controlEnabled != 0) {\n        if (hasHistory != 0) {\n            systemSubState = 3;\n        } else {\n            systemSubState = 2;\n        }\n    } else {\n        if (hasHistory != 0) {\n            systemSubState = 1;\n        } else {\n            systemSubState = 0;\n        }\n    }\n\n    return systemSubState;\n}",
