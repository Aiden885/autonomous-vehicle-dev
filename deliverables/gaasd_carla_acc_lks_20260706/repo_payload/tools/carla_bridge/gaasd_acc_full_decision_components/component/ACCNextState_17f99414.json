            "value": [
                {
                    "standard_library_function": false,
                    "function_body": "int ACCNextState(int systemState, int commandType)\n{\n    int nextState = 3;\n\n    if (systemState == 0) {\n        if ((commandType == 6) || (commandType == 7)) {\n            nextState = 1;\n        } else {\n            nextState = 0;\n        }\n    } else if (systemState == 1) {\n        if ((commandType == 1) || (commandType == 2)) {\n            nextState = 0;\n        } else {\n            nextState = 1;\n        }\n    } else if (systemState == 2) {\n        if (commandType == 1) {\n            nextState = 0;\n        } else {\n            nextState = 2;\n        }\n    } else {\n        nextState = 3;\n    }\n\n    return nextState;\n}",
                    "function_link_obj": ""
                }
