            "key": "other_config",
            "value": [
                {
                    "standard_library_function": false,
                    "function_body": "int ACCHasHistoryNext(int systemState, int commandType, int hasHistory)\n{\n    int nextHasHistory = 0;\n\n    if (hasHistory != 0) {\n        nextHasHistory = 1;\n    } else {\n        nextHasHistory = 0;\n    }\n\n    if (systemState == 0) {\n        nextHasHistory = 1;\n    } else if ((systemState == 1) && ((commandType == 1) || (commandType == 2))) {\n        nextHasHistory = 1;\n    } else if ((systemState == 2) && (commandType == 1)) {\n        nextHasHistory = 1;\n    }\n\n    return nextHasHistory;\n}",
                    "function_link_obj": ""
                }
            ]
        }
