                {
                    "standard_library_function": false,
                    "function_body": "void CARLAEgoState(\n    double *egoV,\n    double *egoX,\n    double *egoY,\n    double *egoYawRad,\n    double *egoAcc,\n    int *valid)\n{\n    extern int carla_adapter_read_ego_state(\n        double *egoV,\n        double *egoX,\n        double *egoY,\n        double *egoYawRad,\n        double *egoAcc,\n        int *valid);\n    int rc = 0;\n\n    rc = carla_adapter_read_ego_state(egoV, egoX, egoY, egoYawRad, egoAcc, valid);\n    if (rc != 0) {\n        if (egoV != 0) {\n            *egoV = 0.0;\n        }\n        if (egoX != 0) {\n            *egoX = 0.0;\n        }\n        if (egoY != 0) {\n            *egoY = 0.0;\n        }\n        if (egoYawRad != 0) {\n            *egoYawRad = 0.0;\n        }\n        if (egoAcc != 0) {\n            *egoAcc = 0.0;\n        }\n        if (valid != 0) {\n            *valid = 0;\n        }\n    }\n}",
