        {
            "key": "other_config",
            "value": [
                {
                    "standard_library_function": false,
                    "function_body": "double CARLAACCComputeTargetSpeed(double egoV, double leadV, double distance)\n{\n    double desiredDist = 15.0;\n    double maxSpeed = 18.0 / 3.6;\n    double kDist = 0.35;\n    double kSpeed = 0.8;\n    double distanceSafe = 0.0;\n    double distDiff = 0.0;\n    double speedDiff = 0.0;\n    double targetSpeed = 0.0;\n\n    if (distance < 0.0) {\n        distanceSafe = 0.0;\n    } else {\n        distanceSafe = distance;\n    }\n\n    distDiff = distanceSafe - desiredDist;\n    speedDiff = leadV - egoV;\n    targetSpeed = (kDist * distDiff) + (kSpeed * speedDiff) + leadV;\n\n    if (targetSpeed < 0.0) {\n        targetSpeed = 0.0;\n    }\n    if (targetSpeed > maxSpeed) {\n        targetSpeed = maxSpeed;\n    }\n\n    return targetSpeed;\n}",
                    "function_link_obj": ""
                }
            ]
        }
