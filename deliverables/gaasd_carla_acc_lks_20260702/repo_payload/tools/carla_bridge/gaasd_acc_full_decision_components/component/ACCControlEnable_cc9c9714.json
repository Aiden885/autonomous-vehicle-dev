            "key": "other_config",
            "value": [
                {
                    "standard_library_function": false,
                    "function_body": "int ACCControlEnable(int systemState, int commandType)\n{\n    int controlEnable = 0;\n\n    if (systemState == 0) {\n        if ((commandType == 6) || (commandType == 7)) {\n            controlEnable = 0;\n        } else {\n            controlEnable = 1;\n        }\n    } else if (systemState == 1) {\n        if ((commandType == 1) || (commandType == 2)) {\n            controlEnable = 1;\n        } else {\n            controlEnable = 0;\n        }\n    } else if (systemState == 2) {\n        if (commandType == 1) {\n            controlEnable = 1;\n        } else {\n            controlEnable = 0;\n        }\n    } else {\n        controlEnable = 0;\n    }\n\n    return controlEnable;\n}",
                    "function_link_obj": ""
                }
