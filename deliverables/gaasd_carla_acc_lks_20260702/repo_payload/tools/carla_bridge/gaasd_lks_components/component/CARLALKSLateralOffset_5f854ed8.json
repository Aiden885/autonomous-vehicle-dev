                    "standard_library_function": false,
                    "function_body": "double CARLALKSLateralOffset(void)\n{\n    extern int carla_adapter_read_lane_tracking(\n        double *lateralOffset,\n        double *headingError,\n        int *laneId,\n        int *roadId,\n        int *valid);\n    double lateralOffset = 0.0;\n    double headingError = 0.0;\n    int laneId = 0;\n    int roadId = 0;\n    int valid = 0;\n    int rc = 0;\n    double result = 0.0;\n\n    rc = carla_adapter_read_lane_tracking(&lateralOffset, &headingError, &laneId, &roadId, &valid);\n    if ((rc == 0) && (valid != 0)) {\n        result = lateralOffset;\n    }\n\n    return result;\n}",
