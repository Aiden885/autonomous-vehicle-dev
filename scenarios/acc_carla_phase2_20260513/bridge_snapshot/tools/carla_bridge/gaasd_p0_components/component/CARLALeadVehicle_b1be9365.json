                {
                    "standard_library_function": false,
                    "function_body": "void CARLALeadVehicle(\n    double *leadV,\n    double *distance,\n    double *relativeSpeed,\n    double *ttc,\n    int *valid)\n{\n    extern int carla_adapter_read_lead_vehicle(\n        double *leadV,\n        double *distance,\n        double *relativeSpeed,\n        double *ttc,\n        int *valid);\n    int rc = 0;\n\n    rc = carla_adapter_read_lead_vehicle(leadV, distance, relativeSpeed, ttc, valid);\n    if (rc != 0) {\n        if (leadV != 0) {\n            *leadV = 0.0;\n        }\n        if (distance != 0) {\n            *distance = 1000000.0;\n        }\n        if (relativeSpeed != 0) {\n            *relativeSpeed = 0.0;\n        }\n        if (ttc != 0) {\n            *ttc = 1000000.0;\n        }\n        if (valid != 0) {\n            *valid = 0;\n        }\n    }\n}",
