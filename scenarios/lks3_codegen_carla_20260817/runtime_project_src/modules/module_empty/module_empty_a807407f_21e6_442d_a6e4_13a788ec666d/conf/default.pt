basic {
  path: "lib/libmodule_empty_a807407f_21e6_442d_a6e4_13a788ec666d.so"
  module_type: APP
  ioconfig {
    subscribers {
      name: "lks_input"
      channel: "lks_input"
      bindcode: ON
